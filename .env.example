# Copy this file to .env and fill in what you have. Everything is optional:
# with no keys at all, the tool still works using free OpenStreetMap data.

# Your email, sent in the User-Agent so site owners / API operators can reach you (good etiquette).
CONTACT_EMAIL=

# Google Places API (New) - fills missing phones/websites, adds rating + review count,
# and drops permanently-closed businesses. Requires a Google Cloud billing account (PAID, pay-as-you-go
# with a monthly free allowance). https://console.cloud.google.com/ -> enable "Places API (New)" -> Credentials
GOOGLE_PLACES_API_KEY=

# California Secretary of State business search API - entity registration date and registered agent
# for LLCs/corporations. FREE key: https://calicodev.sos.ca.gov/ -> sign up -> subscribe to the public search product.
CA_SOS_API_KEY=
# Only change if the SOS changes its API address.
# CA_SOS_API_BASE=https://calico.sos.ca.gov/cbc/v1/api

# Overpass endpoint (OpenStreetMap). Swap to a mirror if the main one is busy:
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
